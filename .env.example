# =============================================================================
# Red Carpet Chemical Inventory — Environment Variables
# Copy this file to .env and fill in real values before starting the app.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
# Docker Compose local dev: postgresql://postgres:postgres@localhost:5432/inventory
# Production: use your cloud provider's connection string (with SSL enabled).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# ---------------------------------------------------------------------------
# API SERVER (required)
# ---------------------------------------------------------------------------
# Port the Express API server listens on.
PORT=8080

# Node environment — set to "production" in production.
NODE_ENV=development

# Secret used to sign session cookies (any long random string).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Admin PIN for the admin panel (4–6 digits). Required — admin access is
# disabled if this is not set.
ADMIN_PIN=1234

# ---------------------------------------------------------------------------
# OPENAI / AI INTEGRATION (required for the Scan Sheet feature)
# ---------------------------------------------------------------------------
# Standard OpenAI credentials (used when running outside Replit):
OPENAI_API_KEY=sk-...

# Optional: override the API base URL (e.g. for Azure OpenAI or a proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: vision model to use for inventory sheet OCR.
# Defaults to "gpt-4o". On Replit AI Integration the default is "gpt-5.4".
# OPENAI_VISION_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# PUSH NOTIFICATIONS — Expo (optional)
# ---------------------------------------------------------------------------
# Required only if you want push notifications via Expo Push Service.
# EXPO_ACCESS_TOKEN=...

# ---------------------------------------------------------------------------
# MOBILE APP (Expo) — build/dev settings
# ---------------------------------------------------------------------------
# The public domain where the API server is reachable from the mobile app.
# Local dev: http://localhost:8080  Production: https://your-domain.com
EXPO_PUBLIC_DOMAIN=http://localhost:8080

# ---------------------------------------------------------------------------
# REPLIT AI INTEGRATION (Replit only — auto-provisioned, do not set manually)
# ---------------------------------------------------------------------------
# AI_INTEGRATIONS_OPENAI_API_KEY=  (set automatically by Replit)
# AI_INTEGRATIONS_OPENAI_BASE_URL= (set automatically by Replit)
