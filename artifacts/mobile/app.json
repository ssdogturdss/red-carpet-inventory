{
  "expo": {
    "name": "Red Carpet Inventory",
    "slug": "mobile",
    "owner": "imaalien",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#cc0000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redcarpetinventory.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.redcarpetinventory.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "Red Carpet Inventory",
      "shortName": "RCI",
      "description": "Chemical inventory management for car wash stores",
      "backgroundColor": "#cc0000",
      "themeColor": "#cc0000",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://RedCarpetInventory.replit.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#cc0000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Red Carpet Inventory to access your photos to attach inventory sheet images.",
          "cameraPermission": "Allow Red Carpet Inventory to use your camera to scan inventory count sheets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "acad93ff-8678-4d60-8825-773258875948"
      }
    }
  }
}
