{
  "expo": {
    "name": "Red Carpet Inventory",
    "slug": "mobile",
    "owner": "syntheticsolutions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#cc0000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redcarpetinventory.app",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.redcarpetinventory.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "Red Carpet Inventory",
      "shortName": "RCI",
      "description": "Chemical inventory management for car wash stores",
      "backgroundColor": "#cc0000",
      "themeColor": "#cc0000",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://redcarpetinventory.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#cc0000"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Red Carpet Inventory to access your photos to attach inventory sheet images.",
          "cameraPermission": "Allow Red Carpet Inventory to use your camera to scan inventory count sheets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "bfd9be3e-0fb3-4402-a511-6866f81edc21"
      }
    }
  }
}
